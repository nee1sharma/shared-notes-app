<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/notebook_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/editor_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/notebook_background"
        app:menu="@menu/menu_note_editor"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_back">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/visibility_toggle"
            android:layout_width="164dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_visibility_track"
            app:checkedButton="@id/visibility_private"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/visibility_private"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/filter_private"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/visibility_shared"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/filter_shared"
                android:textSize="12sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </com.google.android.material.appbar.MaterialToolbar>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/editor_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <LinearLayout
            android:id="@+id/edit_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/title_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/title_hint"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/notebook_on_surface"
                android:textColorHint="@color/notebook_on_surface_variant"
                android:textSize="24sp" />

            <EditText
                android:id="@+id/body_input"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="top|start"
                android:hint="@string/body_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="0dp"
                android:textColor="@color/notebook_on_surface"
                android:textColorHint="@color/notebook_on_surface_variant"
                android:textSize="16sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/read_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="18dp">

                <TextView
                    android:id="@+id/read_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/notebook_on_surface"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/read_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/notebook_on_surface"
                    android:textSize="16sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
